# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# Supabase project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=

# Service-role key (sb_secret_...) — bypasses RLS, used for server-side writes
SUPABASE_KEY=

# Groq API key (Llama 3.3-70B / Whisper)
GROQ_API_KEY=

# Optional / reserved
GEMINI_API_KEY=

# Email (SMTP) for sending organisation invites. Leave blank to skip emails —
# invites still appear in-app on the invitee's dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
